# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for emp_genai database
DB_URL=postgresql://postgres:password@localhost:5432/emp_genai

# ── LLM ───────────────────────────────────────────────────────────────────────
# Path to local GGUF model file.
# Download with: huggingface-cli download TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
#                --include "tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf" --local-dir models/
MODEL_PATH=models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# Number of CPU threads to use for llama.cpp inference (set to your core count)
LLM_THREADS=4

# ── Embedding ─────────────────────────────────────────────────────────────────
# HuggingFace model ID — produces 384-dim vectors, matches vector(384) column
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Document templates ────────────────────────────────────────────────────────
TEMPLATE_PATH=templates/template_answer.docx
OUTPUT_DIR=output
